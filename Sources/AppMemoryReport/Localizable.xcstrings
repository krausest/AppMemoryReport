    "Memory used by several of the app's processes, counted only once in “Memory”" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speicher, den mehrere Prozesse der App nutzen; in „Speicher“ nur einmal gezählt"
