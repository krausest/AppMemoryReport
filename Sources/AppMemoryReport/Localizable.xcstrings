    "Not measured (plain sum)" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht gemessen (einfache Summe)"
          }
        }
      }
    },
    "Plain sum of the individual footprints (footprint unavailable, or skipped because hardly any memory can be shared): shared memory may be counted more than once." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einfache Summe der Einzel-Footprints (footprint nicht verfügbar oder übersprungen, weil kaum Speicher geteilt sein kann): Shared Memory ggf. mehrfach gezählt."
          }
        }
      }
    },
    "Preliminary: sum of the individual footprints, still being measured" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
